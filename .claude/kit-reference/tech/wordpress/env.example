# Copy to .env.local (gitignored) and fill it. Keys only here: this file goes in git.
# Read by scripts/pull-site.sh and by docker compose (--env-file .env.local).

# --- The site ---
SITE_URL=https://www.example.com
SITE_PLUGIN=acme-site
# CHILD_THEME=acme-child
TABLE_PREFIX=wp_

# --- Local copy (docker-compose.yml) ---
LOCAL_URL=http://localhost:8080
LOCAL_PORT=8080
# Production's core and PHP (wp core version; the host's PHP):
WP_IMAGE_TAG=6.8.3-php8.2-apache
WPCLI_IMAGE_TAG=cli-php8.2

# --- Access to bring the site down (pull-site.sh). One of the two ---
# SSH:
PULL_SSH=user@host.example.com
PULL_SSH_PORT=22
# FTPS (TLS forced; never plain FTP). Host = the name on the server's certificate:
PULL_FTP_HOST=server123.example-host.com
PULL_FTP_USER=
PULL_FTP_PASSWORD=
# WordPress root on the server, relative to the login's home (or absolute):
PULL_PATH=public_html
