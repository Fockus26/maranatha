# URL pública del sitio (sin barra final). La usan la metadata de OpenGraph,
# las URLs canónicas, el sitemap y el robots.txt. Sin esto, todo lo que se
# comparta en redes sale con URLs relativas y no funciona.
NEXT_PUBLIC_SITE_URL=https://www.iglesiamaranatha.example

# Subdominio del panel privado (ej. admin.midominio.com). Si se define, el
# middleware sirve el dashboard desde ese subdominio y responde 404 en
# /dashboard del dominio público. Sin esto, el dashboard vive en /dashboard.
# ADMIN_HOST=

# Instagram — IDs de feed de Behold.so (https://behold.so). Uno por cuenta.
# Behold conecta la cuenta por vos (OAuth de una vez, sin el app review de
# Meta) y expone un feed JSON. Plan gratis: 1 feed / hasta 6 posts. La cuenta
# sin feed configurado muestra celdas que enlazan al perfil.
# BEHOLD_FEED_MARANATHA=
# BEHOLD_FEED_EVANGELIO=
# BEHOLD_FEED_JEF=

# ─── Pagos ────────────────────────────────────────────────────────────────
# Supabase (https://supabase.com → Project Settings → API Keys).
# La URL es pública; la clave SECRETA (sb_secret_…) solo vive en el servidor
# y salta RLS — nunca le pongas prefijo NEXT_PUBLIC_.
# La publishable (sb_publishable_…) la usa el login del dashboard.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
