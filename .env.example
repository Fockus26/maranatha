# URL pública del sitio (sin barra final). La usan la metadata de OpenGraph,
# las URLs canónicas, el sitemap y el robots.txt. Sin esto, todo lo que se
# comparta en redes sale con URLs relativas y no funciona.
NEXT_PUBLIC_SITE_URL=https://www.iglesiamaranatha.example

# Subdominio del panel privado (ej. admin.midominio.com). Si se define, el
# middleware sirve el dashboard desde ese subdominio y responde 404 en
# /dashboard del dominio público. Sin esto, el dashboard vive en /dashboard.
# ADMIN_HOST=

# Instagram — IDs de feed de Behold.so (https://behold.so). Uno por cuenta.
# Behold conecta la cuenta por vos (OAuth de una vez, sin el app review de
# Meta) y expone un feed JSON. Plan gratis: 1 feed / hasta 6 posts. La cuenta
# sin feed configurado muestra celdas que enlazan al perfil.
# BEHOLD_FEED_MARANATHA=
# BEHOLD_FEED_EVANGELIO=
# BEHOLD_FEED_JEF=

# ─── Pagos ────────────────────────────────────────────────────────────────
# Base de datos: Postgres del VPS (D082). Las URLs llevan la contraseña: no se
# copian a mano. En tu máquina: `bun run vps:env maranatha_dev` las escribe en
# .env.development.local. En Vercel (pruebas) la de maranatha_preview; en el VPS
# (producción) la de maranatha. DATABASE_URL = PgBouncer (la app);
# DIRECT_URL = directa por el túnel (solo migraciones y scripts).
# DATABASE_URL=
# DIRECT_URL=

# Better Auth (sesiones del dashboard). Secreto: `openssl rand -base64 32`, uno
# distinto por entorno. URL: el origen del panel (https://admin.<dominio> si hay
# ADMIN_HOST): es la base de los enlaces de recuperación de contraseña.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# Correo (recuperación de contraseña): SMTP de Brevo (Brevo → SMTP & API).
# El remitente tiene que estar verificado en Brevo.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Iglesia Maranatha" <maranatha@fockus.dev>

# Comprobantes de pago: bucket privado de Cloudflare R2 (D094), uno por entorno
# (producción y preview). Token de R2 con "Object Read & Write" solo sobre ese
# bucket. Sin estas cuatro, los comprobantes van a la tabla payment_receipts
# (QA local y desarrollo).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Datos de las cuentas que reciben pagos manuales. Se le muestran al donante
# en el paso de pago. Un método sin sus variables obligatorias no se ofrece
# (las marcadas "opcional" pueden quedar vacías).
# PAY_PAGOMOVIL_BANK=Banesco (0134)
# PAY_PAGOMOVIL_PHONE=0414-0000000
# PAY_PAGOMOVIL_ID=V-00000000
# PAY_ZELLE_EMAIL=
# PAY_ZELLE_NAME=
# PAY_BANCOLOMBIA_ACCOUNT_TYPE=Ahorros
# PAY_BANCOLOMBIA_ACCOUNT=
# PAY_BANCOLOMBIA_HOLDER=
# PAY_BANCOLOMBIA_DOCUMENT=            (opcional)
# PAY_BANCOLOMBIA_BREB_KEY=            (opcional)
# PAY_BINANCE_PAY_ID=
# PAY_BINANCE_NAME=                    (opcional)

# Dashboard: correos con acceso de administrador, separados por comas.
# Las cuentas se crean con `bun scripts/create-admin.ts <correo>` (el sitio no
# tiene registro público). Una cuenta que no esté en esta lista
# no puede entrar aunque su contraseña sea correcta.
# ADMIN_EMAILS=tesoreria@ejemplo.com,pastor@ejemplo.com

# PayPal (developer.paypal.com → Apps & Credentials). Sandbox para probar,
# Live en producción — son credenciales distintas. El secreto y el webhook id
# solo viven en el servidor (sin NEXT_PUBLIC_). Sin client id + secret el
# método PayPal/Tarjeta no se ofrece.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Id del webhook creado en la app de PayPal apuntando a
# https://<tu-dominio>/api/payments/paypal/webhook (sin él, los webhooks se
# rechazan y solo confirma la ruta de retorno).
# PAYPAL_WEBHOOK_ID=

# Binance Pay Merchant (merchant.binance.com → Developers → API Keys).
# Exige cuenta de comercio verificada (KYB). Con las dos variables, Binance
# pasa de método manual (PAY_BINANCE_*) a pasarela: el donante paga en la
# página de Binance Pay y el webhook confirma solo. Sin ellas, sigue manual.
# Solo servidor (sin NEXT_PUBLIC_). Webhook:
# https://<tu-dominio>/api/payments/binance/webhook (se manda en cada orden;
# configurarlo también en el Merchant Admin Portal como respaldo).
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_SECRET_KEY=

# QA → .env.test.local (solo existen en la base local; valores inventados)
# ADMIN_EMAIL_TEST=
# ADMIN_PASSWORD_TEST=

# Modo mantenimiento (D079). "1" muestra /mantenimiento con 503 en el sitio
# público (el panel y la API siguen). MAINTENANCE_UNTIL es opcional, ISO 8601.
MAINTENANCE_MODE=
MAINTENANCE_UNTIL=
